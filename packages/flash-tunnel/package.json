{
  "name": "flash-tunnel",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/flash-tunnel/flash-tunnel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flash-tunnel/flash-tunnel.git"
  },
  "bugs": {
    "url": "https://github.com/flash-tunnel/flash-tunnel/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./config": {
      "types": "./dist/config.d.mts",
      "import": "./dist/config.mjs",
      "default": "./dist/config.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "flash-tunnel": "bin/flash-tunnel.mjs"
  },
  "files": [
    "bin",
    "dist"
  ],
  "engines": {
    "node": ">=22.14.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "stub": "unbuild --stub",
    "build": "unbuild",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flash-tunnel/cli": "workspace:*",
    "@flash-tunnel/config": "workspace:*"
  }
}
