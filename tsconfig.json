{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "@flash-tunnel/adapter-cloudflare": ["./packages/adapter-cloudflare/src/index.ts"],
      "@flash-tunnel/cli": ["./packages/cli/src/index.ts"],
      "@flash-tunnel/config": ["./packages/config/src/index.ts"],
      "@flash-tunnel/core": ["./packages/core/src/index.ts"],
      "@flash-tunnel/types": ["./packages/types/src/index.ts"],
      "@flash-tunnel/utils": ["./packages/utils/src/index.ts"]
    },
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/**/*.ts",
    "scripts/**/*.ts",
    "eslint.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["**/dist/**", "**/node_modules/**"]
}
